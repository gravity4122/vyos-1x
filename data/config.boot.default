interfaces {
    loopback lo {
    }
}
service {
    ntp {
        allow-client {
            address "127.0.0.0/8"
            address "169.254.0.0/16"
            address "10.0.0.0/8"
            address "172.16.0.0/12"
            address "192.168.0.0/16"
            address "::1/128"
            address "fe80::/10"
            address "fc00::/7"
        }
        server time1.google.com {
        }
        server time2.google.com {
        }
        server time3.google.com {
        }
    }
}
system {
    config-management {
        commit-revisions "100"
    }
    host-name "devray"
    login {
        operator-group default {
            command-policy {
                allow "*"
            }
        }
        user devray {
            authentication {
                encrypted-password "$6$1ZhuOl7RWCFd2AM2$q19i0aAFus.t1W/i8NMDAAyG6XHCxbVEsRhv3K1qIcMCCAw8PQ91Ld7efc88PEuVYQzhLHYLyThmDUOJAeHVl."
                plaintext-password ""
            }
        }
    }
    option {
        reboot-on-upgrade-failure 5
    }
    syslog {
        local {
            facility all {
                level "info"
            }
            facility local7 {
                level "debug"
            }
        }
    }
}
